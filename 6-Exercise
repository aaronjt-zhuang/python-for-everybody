#Ex.1 Write a while loop that starts at the last character in the string and works its way backwards to the first character in the string, printing each letter on a separate line, except backwards!
word = input('give me a word: ')
lll = 0
index = -1
while lll < len(word):
    letter = word[index]
    lll = lll + 1
    index = index - 1
    print(letter)

