#Ex.3 Encapsulate this code in a function named count, and generalize it so that it accepts the string and the letter as arguments!
def count(word,chosen_letter):
    count = 0
    for letter in word:
        if letter == chosen_letter:
            count = count + 1
    print('Your chosen letter occurs for', count , 'times!')
y = input('Input: ')
x = input('Please choose a letter: ')
count(y,x)

