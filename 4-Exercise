#Ex.6 Rewrite your pay computation with time-and-a-half for overtime and create a function called computepay which takes two parameters (hours and rate)!
hours = float(input("Enter Hours: "))
rate = float(input("Enter Rate: "))
def computepay(hours, rate):
    if hours > 40:
        pay = (40 * rate) + ((hours - 40) * (rate * 1.5))
    else:
        pay = hours * rate
    return pay

print(computepay(hours, rate))

